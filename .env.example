# Runtime UID/GID for the non-root eLabFTW v6 container.
ELABFTW_RUN_UID=1000
ELABFTW_RUN_GID=1000

# Replace every value below before starting the stack.
ELABFTW_DB_PASSWORD=replace-with-a-long-random-password
ELABFTW_MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Generate with:
# docker run --rm --entrypoint /elabftw/vendor/bin/generate-defuse-key elabftw/elabimg:upstream-compatible-custom
ELABFTW_SECRET_KEY=replace-with-output-from-generate-defuse-key

# Optional deployment tuning used by docker-compose.yml.
ELABFTW_BIND_ADDRESS=127.0.0.1
ELABFTW_HTTPS_PORT=3150
ELABFTW_SERVER_NAME=localhost
ELABFTW_SITE_URL=https://localhost:3150
ELABFTW_TIMEZONE=Europe/Zurich
ELABFTW_WEB_MEMORY_LIMIT=2g
ELABFTW_WEB_CPUS=2.0
ELABFTW_MYSQL_MEMORY_LIMIT=2g
ELABFTW_MYSQL_CPUS=2.0
ELABFTW_LOG_MAX_SIZE=10m
ELABFTW_LOG_MAX_FILES=5
ELABFTW_BACKUP_PATH=./backups
CUSTOM_SLOW_OPERATION_MS=500
