SCORESHEET_PORT=8080
PORTAL_ACCESS_CODE=replace-with-a-long-random-value

# Start with demo mode. Demo submissions are saved under ./data.
PYRAT_DEMO_MODE=true
PYRAT_BASE_URL=
PYRAT_AUTH_MODE=basic
PYRAT_USERNAME=
PYRAT_SECRET=
PYRAT_ANIMALS_PATH=

# Do not enable live score writes until the institutional endpoint and payload
# have been validated with the PyRAT administrator and animal-facility SOP.
PYRAT_SCORES_PATH=
# Optional read endpoint used by the Previous entries view in live mode.
PYRAT_SCORES_READ_PATH=
PYRAT_SCORE_WRITE_ENABLED=false
